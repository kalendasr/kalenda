// Domeinmodel: zie docs/DATABASE_DOMAIN.md.
//
// Conventies (niet-onderhandelbaar, zie CLAUDE.md):
//   - UUID primary keys
//   - createdAt / updatedAt op iedere entity
//   - soft delete via deletedAt waar het domeinmodel dat voorschrijft
//   - camelCase velden, PascalCase modellen en enums
//
// Fase 1 voegt de authenticatie- en organisatiemodellen toe: de Better Auth
// kern (User, Session, Account, Verification) en het organisatiedomein
// (Organization, OrganizationPaymentSettings). Latere fasen breiden dit uit.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Authenticatie (Better Auth)
//
// De veldnamen van de kern-modellen volgen het Better Auth standaardschema.
// User is uitgebreid met de domeinvelden uit DATABASE_DOMAIN.md §4. `name`
// blijft bestaan (samengesteld uit voor- en achternaam bij registratie) omdat
// Better Auth het verwacht; `image` fungeert als avatar.
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?

  // Domeinvelden (DATABASE_DOMAIN.md §4).
  firstName String
  lastName  String
  phone     String?
  locale    String  @default("nl")
  timezone  String  @default("America/Paramaribo")

  sessions     Session[]
  accounts     Account[]
  organization Organization?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([email])
  @@map("user")
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Organisatie (DATABASE_DOMAIN.md §4, BUSINESS_RULES BR-100..BR-103)
//
// MVP: precies één organisatie per gebruiker (BR-100) met precies één eigenaar
// (BR-101). Daarom is ownerId uniek. Betaalinstellingen horen bij de
// organisatie, nooit bij een evenement (BR-103).
// ---------------------------------------------------------------------------

model Organization {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?
  logo        String?
  coverImage  String?

  // Contact
  email   String?
  phone   String?
  website String?

  // Sociale media
  facebook  String?
  instagram String?
  tiktok    String?
  linkedin  String?

  // Adres
  address String?
  city    String?
  country String @default("Suriname")

  isVerified Boolean @default(false)

  ownerId String @unique
  owner   User   @relation(fields: [ownerId], references: [id])

  paymentSettings OrganizationPaymentSettings?
  events          Event[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([slug])
  @@index([ownerId])
  @@map("organization")
}

enum PaymentApp {
  Mope
  Uni5Pay
}

model OrganizationPaymentSettings {
  id String @id @default(uuid())

  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // WhatsApp-betaalverzoek (DATABASE_DOMAIN.md §4).
  whatsappEnabled Boolean      @default(false)
  whatsappPhone   String?
  whatsappApps    PaymentApp[]

  // Bankoverschrijving.
  bankEnabled         Boolean @default(false)
  bankName            String?
  accountHolder       String?
  accountNumber       String?
  branch              String?
  paymentInstructions String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("organization_payment_settings")
}

// ---------------------------------------------------------------------------
// Evenementen (DATABASE_DOMAIN.md §5, §6, §15, §16; BUSINESS_RULES BR-200..BR-204)
//
// Fase 2: een organisatie kan evenementen aanmaken, van content voorzien,
// publiceren en archiveren. Live/Finished worden in de UI afgeleid uit
// startsAt/endsAt, dus de opgeslagen status blijft Draft/Published/Archived.
// ---------------------------------------------------------------------------

// Vaste, geseede lijst (SCREENS.md §5). Beheer is admin/seed, geen organizer-UI.
model Category {
  id        String  @id @default(uuid())
  name      String
  slug      String  @unique
  icon      String?
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  events Event[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([slug])
  @@map("category")
}

// Eén venue per event, inline bewerkt binnen het eventformulier (geen aparte
// venue-bibliotheek in de MVP).
model Venue {
  id        String  @id @default(uuid())
  name      String
  address   String?
  district  String?
  country   String  @default("Suriname")
  latitude  Float?
  longitude Float?
  capacity  Int?

  event Event?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("venue")
}

enum EventStatus {
  Draft
  Published
  Archived
}

model Event {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  title            String
  slug             String  @unique
  shortDescription String?
  description      String?
  coverImage       String?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  venueId String? @unique
  venue   Venue?  @relation(fields: [venueId], references: [id])

  startsAt DateTime?
  endsAt   DateTime?
  timezone String    @default("America/Paramaribo")

  status EventStatus @default(Draft)

  content     EventContent[]
  ticketTypes TicketType[]
  orders      Order[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([slug])
  @@index([organizationId])
  @@index([categoryId])
  @@map("event")
}

enum EventContentType {
  Agenda
  Faq
  Speaker
  Rules
}

model EventContent {
  id      String @id @default(uuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  type      EventContentType
  sortOrder Int              @default(0)
  title     String
  content   String
  published Boolean          @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
  @@map("event_content")
}

// Tickettype (DATABASE_DOMAIN.md §7, BUSINESS_RULES BR-300..BR-304).
//
// Bedragen worden als gehele centen opgeslagen (priceCents) om afrondings- en
// serialisatieproblemen te voorkomen. MVP: alleen SRD.
model TicketType {
  id      String @id @default(uuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  name        String
  description String?
  priceCents  Int     @default(0)
  currency    String  @default("SRD")
  quantity    Int

  minimumPerOrder Int @default(1)
  maximumPerOrder Int @default(10)

  salesStart DateTime?
  salesEnd   DateTime?

  visible   Boolean @default(true)
  sortOrder Int     @default(0)

  orderItems OrderItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([eventId])
  @@map("ticket_type")
}

// ---------------------------------------------------------------------------
// Orders (DATABASE_DOMAIN.md §8–10, BUSINESS_RULES BR-400..BR-507, BR-608)
//
// Een order is het hart van het platform. Gastbestellingen: de klant heeft geen
// account (BR-400/403) en benadert de bestelling via een deelbare orderlink.
// Bedragen als gehele centen. Reservering: een order houdt capaciteit bezet tot
// hij verloopt (48u, BR-506) of geannuleerd wordt (BR-507).
// ---------------------------------------------------------------------------

model Customer {
  id        String  @id @default(uuid())
  firstName String
  lastName  String
  email     String
  phone     String

  orders Order[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([email])
  @@map("customer")
}

enum PaymentMethod {
  WhatsApp
  BankTransfer
}

enum OrderStatus {
  PendingPayment
  AwaitingReview
  Paid
  Completed
  Cancelled
  Expired
}

enum PaymentStatus {
  Unpaid
  Pending
  Verified
  Rejected
}

model Order {
  id      String @id @default(uuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  orderNumber String @unique

  paymentMethod PaymentMethod
  paymentApp    PaymentApp?
  orderStatus   OrderStatus   @default(PendingPayment)
  paymentStatus PaymentStatus @default(Unpaid)

  currency        String @default("SRD")
  subtotalCents   Int
  serviceFeeCents Int    @default(0)
  discountCents   Int    @default(0)
  totalCents      Int

  notes     String?
  expiresAt DateTime

  items OrderItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([eventId])
  @@index([customerId])
  @@index([orderNumber])
  @@map("order")
}

model OrderItem {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  ticketTypeId String
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id])

  quantity        Int
  unitPriceCents  Int
  totalPriceCents Int

  @@index([orderId])
  @@index([ticketTypeId])
  @@map("order_item")
}
