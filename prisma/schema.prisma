// Domeinmodel: zie docs/DATABASE_DOMAIN.md.
//
// Conventies (niet-onderhandelbaar, zie CLAUDE.md):
//   - UUID primary keys
//   - createdAt / updatedAt op iedere entity
//   - soft delete via deletedAt waar het domeinmodel dat voorschrijft
//   - camelCase velden, PascalCase modellen en enums
//
// Fase 1 voegt de authenticatie- en organisatiemodellen toe: de Better Auth
// kern (User, Session, Account, Verification) en het organisatiedomein
// (Organization, OrganizationPaymentSettings). Latere fasen breiden dit uit.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Authenticatie (Better Auth)
//
// De veldnamen van de kern-modellen volgen het Better Auth standaardschema.
// User is uitgebreid met de domeinvelden uit DATABASE_DOMAIN.md §4. `name`
// blijft bestaan (samengesteld uit voor- en achternaam bij registratie) omdat
// Better Auth het verwacht; `image` fungeert als avatar.
// ---------------------------------------------------------------------------

model User {
  id            String  @id @default(uuid())
  name          String
  email         String  @unique
  emailVerified Boolean @default(false)
  image         String?

  // Domeinvelden (DATABASE_DOMAIN.md §4).
  firstName String
  lastName  String
  phone     String?
  locale    String  @default("nl")
  timezone  String  @default("America/Paramaribo")

  // Platformbeheer (Fase 11). Losstaand van het organisator/klant-onderscheid:
  // een platformbeheerder heeft geen eigen Organization. `blockedAt` is een
  // aparte, omkeerbare toestand naast `deletedAt` (echte soft delete) — een
  // geblokkeerde gebruiker blijft bestaan maar kan niet inloggen totdat een
  // beheerder de blokkade opheft.
  isPlatformAdmin Boolean   @default(false)
  blockedAt       DateTime?

  sessions                Session[]
  accounts                Account[]
  organization            Organization?
  orders                  Order[]
  checkIns                CheckIn[]
  checkedInTickets        Ticket[]                 @relation("TicketCheckedBy")
  pushSubscriptions       PushSubscription[]
  notificationPreferences NotificationPreference[]
  auditLogs               AuditLog[]               @relation("AuditActor")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([email])
  @@index([createdAt])
  @@index([isPlatformAdmin])
  @@map("user")
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Organisatie (DATABASE_DOMAIN.md §4, BUSINESS_RULES BR-100..BR-103)
//
// MVP: precies één organisatie per gebruiker (BR-100) met precies één eigenaar
// (BR-101). Daarom is ownerId uniek. Betaalinstellingen horen bij de
// organisatie, nooit bij een evenement (BR-103).
// ---------------------------------------------------------------------------

model Organization {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?
  logo        String?
  coverImage  String?

  // Contact
  email   String?
  phone   String?
  website String?

  // Sociale media
  facebook  String?
  instagram String?
  tiktok    String?
  linkedin  String?

  // Adres
  address String?
  city    String?
  country String  @default("Suriname")

  isVerified Boolean @default(false)

  ownerId String @unique
  owner   User   @relation(fields: [ownerId], references: [id])

  paymentSettings OrganizationPaymentSettings?
  events          Event[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([slug])
  @@index([ownerId])
  @@map("organization")
}

enum PaymentApp {
  Mope
  Uni5Pay
}

model OrganizationPaymentSettings {
  id String @id @default(uuid())

  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // WhatsApp-betaalverzoek (DATABASE_DOMAIN.md §4).
  whatsappEnabled Boolean      @default(false)
  whatsappPhone   String?
  whatsappApps    PaymentApp[]

  // Bankoverschrijving.
  bankEnabled         Boolean @default(false)
  bankName            String?
  accountHolder       String?
  accountNumber       String?
  branch              String?
  paymentInstructions String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("organization_payment_settings")
}

// ---------------------------------------------------------------------------
// Evenementen (DATABASE_DOMAIN.md §5, §6, §15, §16; BUSINESS_RULES BR-200..BR-204)
//
// Fase 2: een organisatie kan evenementen aanmaken, van content voorzien,
// publiceren en archiveren. Live/Finished worden in de UI afgeleid uit
// startsAt/endsAt, dus de opgeslagen status blijft Draft/Published/Archived.
// ---------------------------------------------------------------------------

// Vaste, geseede lijst (SCREENS.md §5). Beheer is admin/seed, geen organizer-UI.
model Category {
  id        String  @id @default(uuid())
  name      String
  slug      String  @unique
  icon      String?
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  events Event[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([slug])
  @@map("category")
}

// Eén venue per event, inline bewerkt binnen het eventformulier (geen aparte
// venue-bibliotheek in de MVP).
model Venue {
  id        String  @id @default(uuid())
  name      String
  address   String?
  district  String?
  country   String  @default("Suriname")
  latitude  Float?
  longitude Float?
  capacity  Int?

  event Event?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("venue")
}

enum EventStatus {
  Draft
  Published
  Archived
}

model Event {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  title            String
  slug             String  @unique
  shortDescription String?
  description      String?
  coverImage       String?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  venueId String? @unique
  venue   Venue?  @relation(fields: [venueId], references: [id])

  startsAt DateTime?
  endsAt   DateTime?
  timezone String    @default("America/Paramaribo")

  status EventStatus @default(Draft)

  content     EventContent[]
  ticketTypes TicketType[]
  orders      Order[]
  checkIns    CheckIn[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([slug])
  @@index([organizationId])
  @@index([categoryId])
  @@index([status])
  @@index([createdAt])
  @@map("event")
}

enum EventContentType {
  Agenda
  Faq
  Speaker
  Rules
}

model EventContent {
  id      String @id @default(uuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  type      EventContentType
  sortOrder Int              @default(0)
  title     String
  content   String
  published Boolean          @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
  @@map("event_content")
}

// Tickettype (DATABASE_DOMAIN.md §7, BUSINESS_RULES BR-300..BR-304).
//
// Bedragen worden als gehele centen opgeslagen (priceCents) om afrondings- en
// serialisatieproblemen te voorkomen. MVP: alleen SRD.
model TicketType {
  id      String @id @default(uuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  name        String
  description String?
  priceCents  Int     @default(0)
  currency    String  @default("SRD")
  quantity    Int

  minimumPerOrder Int @default(1)
  maximumPerOrder Int @default(10)

  salesStart DateTime?
  salesEnd   DateTime?

  visible   Boolean @default(true)
  sortOrder Int     @default(0)

  orderItems OrderItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([eventId])
  @@map("ticket_type")
}

// ---------------------------------------------------------------------------
// Orders (DATABASE_DOMAIN.md §8–10, BUSINESS_RULES BR-400..BR-507, BR-608)
//
// Een order is het hart van het platform. Gastbestellingen: de klant heeft geen
// account (BR-400/403) en benadert de bestelling via een deelbare orderlink.
// Bedragen als gehele centen. Reservering: een order houdt capaciteit bezet tot
// hij verloopt (48u, BR-506) of geannuleerd wordt (BR-507).
// ---------------------------------------------------------------------------

model Customer {
  id        String @id @default(uuid())
  firstName String
  lastName  String
  email     String
  phone     String

  orders            Order[]
  pushSubscriptions PushSubscription[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([email])
  @@map("customer")
}

enum PaymentMethod {
  WhatsApp
  BankTransfer
}

enum OrderStatus {
  PendingPayment
  AwaitingReview
  Paid
  Completed
  Cancelled
  Expired
}

enum PaymentStatus {
  Unpaid
  Pending
  Verified
  Rejected
}

// Betaaltoestand van een Payment-record (Fase 5). Zie DATABASE_DOMAIN.md §11.
// Benoemd als `PaymentState` om de bestaande `PaymentStatus`-enum op Order niet
// te verstoren — de Order draagt de gedenormaliseerde projectie, dit is de
// werkelijke betaaladministratie.
enum PaymentState {
  Waiting
  // WhatsApp-flow: organisator heeft het betaalverzoek verstuurd, wacht op
  // de klant (Fase 9, BR-602). Bank-flow gaat hier nooit doorheen.
  Requested
  Submitted
  Verified
  Rejected
  Cancelled
}

// Kanaal waarlangs een ticket daadwerkelijk is afgeleverd (Fase 9). Bij
// WhatsApp-levering verstuurt het platform zelf niets — het opent het gesprek
// met de organisator en registreert alleen dat de link is gedeeld.
enum TicketDeliveryChannel {
  Email
  WhatsApp
}

model Order {
  id      String @id @default(uuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  // Koppeling naar de ingelogde koper (null voor historische gastbestellingen).
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  orderNumber String @unique

  paymentMethod PaymentMethod
  paymentApp    PaymentApp?
  orderStatus   OrderStatus   @default(PendingPayment)
  paymentStatus PaymentStatus @default(Unpaid)

  currency        String @default("SRD")
  subtotalCents   Int
  serviceFeeCents Int    @default(0)
  discountCents   Int    @default(0)
  totalCents      Int

  notes     String?
  expiresAt DateTime

  items   OrderItem[]
  payment Payment?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([eventId])
  @@index([customerId])
  @@index([userId])
  @@index([orderNumber])
  @@index([createdAt])
  @@index([orderStatus])
  @@index([paymentStatus])
  @@map("order")
}

model OrderItem {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  ticketTypeId String
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id])

  quantity        Int
  unitPriceCents  Int
  totalPriceCents Int

  tickets Ticket[]

  @@index([orderId])
  @@index([ticketTypeId])
  @@map("order_item")
}

// Betaaladministratie per order (Fase 5, DATABASE_DOMAIN.md §11).
//
// Het platform verwerkt geen geld (BR-600); dit vast de workflow. Eén Payment
// per order (1:1), aangemaakt bij checkout en bijgewerkt bij elke stap:
//
//   WhatsApp:  Waiting → Verified (organisator bevestigt) | Rejected
//   Bank:      Waiting → Submitted (klant uploadt bewijs) → Verified (goedkeuren) | Rejected
//              Rejected → Submitted (opnieuw indienen, BR-605)
//
// `proofKey` is de private R2-sleutel van het betaalbewijs; organisatoren zien
// het alleen via een beveiligde, korte download-URL (opslag.server getSignedDownloadUrl).
model Payment {
  id      String @id @default(uuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id])

  method    PaymentMethod
  state     PaymentState  @default(Waiting)
  reference String?
  proofKey  String?

  // WhatsApp-flow: wanneer en door wie het betaalverzoek is verstuurd
  // (Fase 9, BR-602). Ontbreekt in de bank-flow.
  requestedAt DateTime?
  requestedBy String?

  verifiedBy String?
  verifiedAt DateTime?
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([state])
  @@map("payment")
}

// ---------------------------------------------------------------------------
// Tickets (DATABASE_DOMAIN.md §12, BUSINESS_RULES BR-700..BR-704)
//
// Fase 6: één ticket per "stoel" (per eenheid in een OrderItem), aangemaakt
// zodra de betaling is bevestigd (BR-604). QR-inhoud wordt afgeleid uit het
// unieke ticketnummer (BR-700/701) — er is geen afzonderlijke qrCode-kolom,
// zodat er maar één bron van waarheid is en bij opnieuw versturen de QR gelijk
// blijft (BR-704). Scan/check-in statussen (CheckedIn/Cancelled) komen in Fase 7
// en worden nu al in het model gezet (BR-702).
// ---------------------------------------------------------------------------

enum TicketStatus {
  Issued
  Sent
  CheckedIn
  Cancelled
}

model Ticket {
  id          String    @id @default(uuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  // Uniek, botvrij nummer (UUID) dat in de QR-code staat (BR-700/701).
  ticketNumber String                 @unique
  status       TicketStatus           @default(Issued)
  issuedAt     DateTime               @default(now())
  // Laatste keer dat de ticket verstuurd is, en via welk kanaal (BR-702/704).
  sentAt       DateTime?
  sentVia      TicketDeliveryChannel?
  cancelledAt  DateTime?
  // Check-in: wanneer en door wie ingecheckt (BR-801). Gedenormaliseerd voor
  // snelle weergave; de volledige scangeschiedenis staat in CheckIn (BR-800).
  checkedInAt  DateTime?
  checkedInBy  String?
  checkedBy    User?                  @relation("TicketCheckedBy", fields: [checkedInBy], references: [id])

  checkIns CheckIn[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderItemId])
  @@index([ticketNumber])
  @@index([status])
  @@index([checkedInAt])
  @@map("ticket")
}

// ---------------------------------------------------------------------------
// Check-in / Scanner (DATABASE_DOMAIN.md §13, BUSINESS_RULES BR-800..BR-804)
//
// Fase 7: iedere scan wordt opgeslagen (BR-800), ook mislukte. Het resultaat
// volgt de business rules:
//   Valid            — eerste scan van een geldig ticket (BR-801)
//   AlreadyCheckedIn — tweemaal scannen van een ingecheckt ticket (BR-802)
//   Invalid          — geannuleerd ticket (BR-803)
//   NotFound         — ticket bestaat niet of hoort niet bij dit event (BR-804)
//
// `ticketId` is optioneel: een NotFound-scan heeft geen ticket, maar het
// gescande nummer wordt altijd bewaard voor de audit. Er is géén unieke
// constraint op ticketId — dubbele scans zijn legitieme rijen.
// ---------------------------------------------------------------------------

enum CheckInResult {
  Valid
  AlreadyCheckedIn
  Invalid
  NotFound
}

model CheckIn {
  id      String @id @default(uuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Optioneel: ontbreekt bij een NotFound-scan (BR-804).
  ticketId String?
  ticket   Ticket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  // Altijd ingevuld: het gescande nummer, ook als het ticket niet bestaat.
  ticketNumber String

  scannedById String
  scannedBy   User   @relation(fields: [scannedById], references: [id], onDelete: Cascade)

  result    CheckInResult
  scannedAt DateTime      @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId, scannedAt])
  @@index([ticketId])
  @@map("check_in")
}

// ---------------------------------------------------------------------------
// Pushmeldingen (Fase 8). Zie DATABASE_DOMAIN.md §14.
//
// Eén PushSubscription = één browser-installatie. Hoort óf bij een organisator
// (userId) óf bij een gastklant (customerId), nooit bij beide en nooit bij geen
// van beide. Prisma kan die "precies één"-regel niet uitdrukken; de migratie
// voegt daarom een CHECK-constraint toe.
//
// LET OP — bewuste afwijking van de huisregels: dit model heeft GEEN deletedAt
// en gebruikt HARDE delete. Een browser die opnieuw abonneert hergebruikt
// dezelfde `endpoint`; een soft-deleted rij zou botsen met de unique-constraint
// en het opnieuw aanzetten stukmaken. Een dood abonnement heeft geen audit-waarde.
// ---------------------------------------------------------------------------
model PushSubscription {
  id String @id @default(uuid())

  // De push-service-URL; dit ís de identiteit van dit apparaat.
  endpoint String @unique
  // Publieke sleutel + auth-secret van de client, nodig voor de encryptie.
  p256dh   String
  auth     String

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Gastklant zonder account. Het ordernummer op de orderpagina is de sleutel
  // waarmee de klant zich abonneert — hetzelfde vertrouwensmodel als het
  // uploaden van een betaalbewijs.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  userAgent    String?
  lastSeenAt   DateTime @default(now())
  // Aantal opeenvolgende tijdelijke verzendfouten; boven een drempel opruimen.
  failureCount Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([customerId])
  @@map("push_subscription")
}

// Per-type voorkeur van een organisator. De AFWEZIGHEID van een rij betekent
// "gebruik de standaard uit de registry" — er wordt pas een rij geschreven als
// de organisator een schakelaar omzet. Zo kost een nieuw notificatietype geen
// migratie en kan één upsert nooit een andere wijziging overschrijven.
model NotificationPreference {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Registry-sleutel, bijv. "order.created".
  type    String
  enabled Boolean

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, type])
  @@index([userId])
  @@map("notification_preference")
}

// Claim-tabel, GEEN bezorglog: één rij = "dit bericht is (of wordt nu)
// verstuurd". De unique-constraint ís de vergrendeling — de verliezer van een
// gelijktijdige insert krijgt P2002 en slaat over. Zo wordt een herinnering
// nooit twee keer verstuurd en een bijna-uitverkocht-melding maar één keer.
model NotificationLog {
  id String @id @default(uuid())

  type      String
  // Deterministische doel-sleutel, bijv. "event:<uuid>" of "order:<uuid>".
  targetKey String
  sentAt    DateTime @default(now())

  @@unique([type, targetKey])
  @@map("notification_log")
}

// ---------------------------------------------------------------------------
// Audit log (Fase 12)
//
// Append-only: rijen worden nooit gewijzigd of verwijderd — daarom geen
// `updatedAt` en geen `deletedAt`. Er bestaat bewust géén server function die
// een AuditLog muteert of verwijdert; de enige schrijver is
// `writeAuditLog()` in het adminserverdomein.
//
// Registreert vandaag uitsluitend platformbeheerder-acties. Het model is
// generiek genoeg om later ook organisator-acties vast te leggen (BR §17)
// zonder migratie van bestaande rijen: dan komen er enkel enum-waarden bij.
//
// `targetLabel` is een momentopname van de naam op het moment van de actie,
// zodat het log leesbaar blijft nadat het doel hernoemd of verwijderd is.
// `metadata` bevat alleen de gewijzigde toestand (before/after) — nooit
// wachtwoorden, tokens, betaalbewijzen of andere geheimen.
// ---------------------------------------------------------------------------

enum AuditAction {
  UserBlocked
  UserUnblocked
  UserRoleGranted
  UserRoleRevoked
  UserDeleted
  OrganizationDeactivated
  OrganizationReactivated
  OrganizationVerified
  OrganizationUnverified
  EventPublished
  EventUnpublished
  EventArchived
  EventDeleted
  CategoryCreated
  CategoryUpdated
}

enum AuditTargetType {
  User
  Organization
  Event
  Category
}

model AuditLog {
  id String @id @default(uuid())

  // Altijd de handelende beheerder; nooit nullable. Een audit log zonder
  // actor heeft geen waarde.
  actorId String
  actor   User   @relation("AuditActor", fields: [actorId], references: [id])

  action      AuditAction
  targetType  AuditTargetType
  targetId    String
  targetLabel String
  metadata    Json?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([targetType, targetId])
  @@index([action])
  @@map("audit_log")
}
