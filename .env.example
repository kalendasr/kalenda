# Kopieer dit bestand naar .env en vul de waarden in.
# .env staat in .gitignore en hoort nooit in de repository.

NODE_ENV=development

# --- Database -------------------------------------------------------------
# PostgreSQL connectiestring.
DATABASE_URL="postgresql://kalenda:kalenda@localhost:5432/kalenda?schema=public"

# --- Auth (Better Auth) ---------------------------------------------------
# Genereer een secret met: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# --- Google-login -----------------------------------------------------------
# Optioneel: alleen nodig om "Doorgaan met Google" te tonen. Maak credentials
# aan via de Google Cloud Console (OAuth consent screen + OAuth client ID,
# type "Web application") met redirect-URI:
#   ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Bestandsopslag (Cloudflare R2) ---------------------------------------
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="kalenda"
# Publieke basis-URL van de bucket (custom domain of r2.dev).
R2_PUBLIC_URL="https://cdn.example.com"

# --- E-mail (Resend) ------------------------------------------------------
# Alleen nodig zodra er e-mail wordt verstuurd (bijv. wachtwoord resetten).
MAIL_API_KEY=""
MAIL_AFZENDER_NAAM="Kalenda"
MAIL_AFZENDER_EMAIL="tickets@example.com"

# --- Web Push (pushmeldingen) ---------------------------------------------
# Genereer een sleutelpaar met: npx web-push generate-vapid-keys
# De publieke sleutel deelt de browser; de private sleutel blijft geheim.
# VAPID_SUBJECT is een contact-mailto voor de pushdienst.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:tickets@example.com"

# --- Geplande taken (cron) ------------------------------------------------
# Gedeeld geheim waarmee GitHub Actions de herinnerings-route mag aanroepen.
# Genereer met: openssl rand -base64 32
CRON_SECRET=""
